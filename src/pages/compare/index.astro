---
import CompareTable from '../../components/CompareTable.astro'
import CompareLayout from '../../layouts/CompareLayout.astro'
import { COMPARE_HEADINGS, COMPARE_INDEX, COMPARE_PAGES, REVIEWED_ON, ROWS, TOOLS, type ToolId } from '../../data/compare'
import { renderFragment } from '../../lib/markdown'
import { breadcrumbLd, graph } from '../../lib/seo'

const allTools: ToolId[] = ['klustr', 'lens', 'k9s', 'headlamp', 'dashboard']
---

<CompareLayout
  title={COMPARE_INDEX.title}
  eyebrow="compare"
  lede={COMPARE_INDEX.lede}
  description={COMPARE_INDEX.description}
  path="/compare/"
  ogType="website"
  jsonLd={graph([breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Compare', path: '/compare/' }])])}
>
  <section class="mt-10">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 id="at-a-glance" class="display scroll-mt-24 text-2xl">{COMPARE_HEADINGS.glance}</h2>
      <p class="font-mono text-sm text-ink-3">{ROWS.length} rows, reviewed {REVIEWED_ON}</p>
    </div>
    <CompareTable tools={allTools} class="mt-5" />
  </section>

  <section class="mt-14">
    <h2 id="pages" class="display scroll-mt-24 text-2xl">{COMPARE_HEADINGS.pages}</h2>
    <p class="lede mt-3 max-w-[68ch]">{COMPARE_INDEX.pagesLede}</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        COMPARE_PAGES.map((page) => (
          <a href={`/compare/${page.slug}/`} class="sheet cap block no-underline hover:border-ink">
            <h3>{page.heading}</h3>
            <p>{TOOLS[page.tool].summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="prose mt-14">
    <h2 id="method">{COMPARE_HEADINGS.method}</h2>
    {COMPARE_INDEX.method.map((p) => <Fragment set:html={renderFragment(p)} />)}
  </section>
</CompareLayout>
