---
import { getImage } from 'astro:assets'
import {
  Blocks,
  Boxes,
  Download,
  FileDiff,
  KeyRound,
  Layers,
  Play,
  Puzzle,
  Scale,
  ScanSearch,
  Server,
  ShieldCheck,
  SquareTerminal,
  X,
  Zap,
} from '@lucide/astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import BrandIcon from '../components/BrandIcon.astro'
import CompareTable from '../components/CompareTable.astro'
import FeatureTabs, { type Feature } from '../components/FeatureTabs.astro'
import HeroSlider from '../components/HeroSlider.astro'
import InstallTabs from '../components/InstallTabs.astro'
import heroPoster from '../assets/hero-poster.png'
import { CAPABILITY_CLIPS, DEMO_TITLE, clipById } from '../data/clips'
import { REVIEWED_ON, ROWS } from '../data/compare'
import { FEATURE_LIST } from '../data/features'
import { SHOTS, shotBySlug } from '../data/shots'
import { firstRelease, latestRelease } from '../lib/github'
import { graph, personLd, softwareLd, sourceCodeLd, websiteLd } from '../lib/seo'
import { LATEST_RELEASE_URL, REPO_URL, SITE, absoluteUrl } from '../lib/site'

const release = await latestRelease()
const first = await firstRelease()
const version = release?.tag

const screenshotUrls = await Promise.all(
  SHOTS.slice(0, 8).map(async (s) => absoluteUrl((await getImage({ src: s.image, width: 1600, format: 'webp' })).src)),
)
const poster = await getImage({ src: heroPoster, width: 1280, format: 'webp' })

const jsonLd = graph([
  personLd(),
  websiteLd(),
  softwareLd({
    version,
    screenshots: screenshotUrls,
    features: FEATURE_LIST,
    datePublished: first?.publishedAt,
    dateModified: release?.publishedAt,
  }),
  sourceCodeLd(),
])

const features: Feature[] = [
  {
    id: 'multi-context',
    eyebrow: 'multi-context',
    heading: 'Multi-cluster: two clusters, one table.',
    body: 'Check two or more contexts on the Connections screen and every list fans out across them with a Context column. Save the selection as a named group, tag production with a color, and the top bar paints a stripe so you always know which environment you are touching. Per-context read-only mode blocks every mutation when you only mean to look.',
    chips: [
      { value: '2+', label: 'contexts in one list' },
      { value: 'Groups', label: 'one-click reconnect' },
      { value: 'Read-only', label: 'per context' },
    ],
    shot: shotBySlug('pods-aggregated'),
    link: { href: '/docs/multi-context/', label: 'Multi-context guide' },
  },
  {
    id: 'debugging',
    eyebrow: 'debugging',
    heading: 'Debugging: logs, exec, debug containers, node shell.',
    body: 'Stream logs across every pod of a workload with a color per pod, follow, regex and save. Open a shell in any container, or inject an ephemeral debug container when the image has no shell. From a node, open a root shell through a temporary nsenter pod that is removed when you close it, then cordon and drain with live progress.',
    chips: [
      { value: 'Multi-pod', label: 'one stream, one color each' },
      { value: 'kubectl debug', label: 'built in' },
      { value: 'Drain', label: 'PDB-aware, live progress' },
    ],
    shot: shotBySlug('logs-stream'),
    link: { href: '/docs/workloads-and-debugging/', label: 'Workloads and debugging guide' },
  },
  {
    id: 'helm',
    eyebrow: 'helm',
    heading: 'Helm: dry-run first, then apply.',
    body: 'Helm v3 runs inside Klustr through the upstream library, with no helm binary on your PATH. Every install and upgrade renders as a dry-run diff you confirm before anything changes. Releases are read from the Secret informer that is already open, so the list stays live without extra polling.',
    chips: [
      { value: 'Diff', label: 'before every apply' },
      { value: 'Rollback', label: 'to any revision' },
      { value: 'Repos', label: 'chart search and versions' },
    ],
    shot: shotBySlug('helm-upgrade'),
    link: { href: '/docs/helm/', label: 'Helm guide' },
  },
  {
    id: 'argocd',
    eyebrow: 'argo cd',
    heading: 'Argo CD: sync and refresh through the API.',
    body: 'Applications appear as soon as the Argo CD CRDs are detected, with Sync and Health pills, revision and repo on every row. Sync sends the same PATCH that argocd app sync does, Refresh flips the annotation, and Rollback and cascade-aware Delete are one click. The Resources tab lists every managed object and deep-links into it. No argocd-server ingress, no Argo login, no CLI.',
    chips: [
      { value: 'Sync', label: 'the argocd app sync payload' },
      { value: 'Resources', label: 'every managed object, linked' },
      { value: '0', label: 'logins or CLIs' },
    ],
    shot: shotBySlug('argo-applications'),
    link: { href: '/docs/gitops/', label: 'GitOps guide' },
  },
  {
    id: 'flux',
    eyebrow: 'flux cd',
    heading: 'Flux CD: reconcile and suspend, twelve kinds.',
    body: 'Kustomizations, HelmReleases, Git, Helm and OCI repositories, Buckets, Providers, Alerts and Receivers, each with conditions, source and applied revision up front. Image automation adds the tags an ImageRepository scanned, the image an ImagePolicy picked and the last commit an ImageUpdateAutomation pushed. Reconcile and Suspend set the standard Flux annotations, so a failed Kustomization is fixed from the same screen that shows why it failed.',
    chips: [
      { value: '12', label: 'toolkit kinds, image automation included' },
      { value: 'Reconcile', label: 'the standard annotation' },
      { value: 'Suspend', label: 'and resume' },
    ],
    shot: shotBySlug('flux-kustomization'),
    link: { href: '/docs/gitops/', label: 'GitOps guide' },
  },
  {
    id: 'tekton',
    eyebrow: 'tekton',
    heading: 'Tekton: why a pipeline failed, in one table.',
    body: 'PipelineRuns show the controller’s status, a task tally and a live duration. A run’s detail draws its tasks as a graph and joins the resolved pipeline with its TaskRuns: the task that failed, the tasks its failure skipped and why, and the finally tasks that still ran. Step logs open on the failed step. Start a Pipeline from a form of its params and workspaces, cancel or rerun without tkn, and follow EventListeners to the templates they fire.',
    chips: [
      { value: 'Task table', label: 'pipeline, TaskRuns and skips joined' },
      { value: 'Start', label: 'params and workspaces form' },
      { value: 'Triggers', label: 'EventListeners to templates' },
    ],
    shot: shotBySlug('tekton-pipelinerun'),
    link: { href: '/docs/tekton/', label: 'Tekton guide' },
  },
  {
    id: 'gateway',
    eyebrow: 'gateway api',
    heading: 'Gateway API: route status you can read.',
    body: 'Gateways, HTTP, GRPC, TLS, TCP and UDP routes, ListenerSets and BackendTLSPolicies through typed informers. A route renders as a per-rule match, backend and weight matrix with the RouteParentStatus beside it, so a parent that has not accepted a route or a RefNotPermitted backend is one click away. Vendor-neutral: Envoy Gateway, Cilium, Istio, Contour or NGINX Gateway Fabric.',
    chips: [
      { value: 'RouteParentStatus', label: 'per parent, per controller' },
      { value: '10', label: 'Gateway API kinds' },
      { value: 'Envoy', label: 'or any conformant implementation' },
    ],
    shot: shotBySlug('gateway-httproutes'),
    link: { href: '/docs/gateway-api/', label: 'Gateway API guide' },
  },
  {
    id: 'cert-manager',
    eyebrow: 'cert-manager',
    heading: 'cert-manager: the issuance chain, one tab away.',
    body: 'Certificates with ready state and expiry, Issuers and ClusterIssuers with their type collapsed into one column, and a drill-down from Certificate through CertificateRequest and Order to the Challenge, with the ACME error that explains a stuck issuance. Renew is one click, with no cmctl on your PATH.',
    chips: [
      { value: 'Chain', label: 'Certificate to Challenge' },
      { value: 'Renew', label: 'one click, no cmctl' },
      { value: 'Expiry', label: 'and renewal time' },
    ],
    shot: shotBySlug('certmanager-chain'),
    link: { href: '/docs/integrations/', label: 'Platform integrations' },
  },
  {
    id: 'kyverno',
    eyebrow: 'kyverno',
    heading: 'Kyverno: policy findings on the resource they flag.',
    body: 'ClusterPolicies, Policies, PolicyExceptions and every CEL policy kind, validating, image-validating, mutating, generating and deleting, with their rules, actions and what they match. Policy reports list a resource’s results worst first, each policy lists the resources it fails, and a Deployment or Pod with a report gets a Policy tab with the failing count on its label. Read-only, through the Kubernetes API.',
    chips: [
      { value: 'Policy tab', label: 'on the resource it flags' },
      { value: 'Violations', label: 'per policy, across reports' },
      { value: 'CEL', label: 'all five policy kinds' },
    ],
    shot: shotBySlug('kyverno-policy-tab'),
    link: { href: '/docs/kyverno/', label: 'Kyverno guide' },
  },
  {
    id: 'istio',
    eyebrow: 'istio',
    heading: 'Istio: traffic splits without the YAML.',
    body: 'VirtualServices show their hosts, gateways and every route as a match with weighted destinations, and link each host to its Service and each DestinationRule subset to the pods it selects. Gateways, ServiceEntries, Sidecars, PeerAuthentications, AuthorizationPolicies and RequestAuthentications show what they configure and the workloads they apply to. The served API version comes from the discovered CRD, so the views follow whatever Istio the cluster runs.',
    chips: [
      { value: '90 / 10', label: 'canary split, readable' },
      { value: 'Subsets', label: 'linked to their pods' },
      { value: '8', label: 'kinds, watch-backed' },
    ],
    shot: shotBySlug('istio-virtualservice'),
    link: { href: '/docs/integrations/', label: 'Platform integrations' },
  },
  {
    id: 'karpenter',
    eyebrow: 'karpenter',
    heading: 'Karpenter: node pools, claims and node classes, live.',
    body: 'NodePools with weight, node class, consolidation policy and CPU and memory against their limits. NodeClaims with node, instance type, capacity type, zone and the Launched, Registered and Initialized steps, so a claim stuck before registration stands out. On AWS, EC2NodeClasses show the subnets, security groups and AMIs their selector terms resolved to. A Disruption tab on every Karpenter node says why Karpenter is not removing it: a do-not-disrupt pod, a PDB, a budget or consolidateAfter.',
    chips: [
      { value: 'Limits', label: 'CPU and memory against used' },
      { value: 'Disruption', label: 'what holds a node, and why' },
      { value: 'EC2NodeClass', label: 'subnets, security groups, AMIs' },
    ],
    shot: shotBySlug('karpenter-nodeclaims'),
    link: { href: '/docs/integrations/', label: 'Platform integrations' },
  },
  {
    id: 'keda',
    eyebrow: 'keda',
    heading: 'KEDA: triggers instead of s0-prometheus.',
    body: 'ScaledObjects and ScaledJobs with their triggers and Ready, Active, Fallback and Paused state, and TriggerAuthentications with the objects that use them, without reading a secret value. Pause holds a ScaledObject at its current or a given replica count, and Resume clears it. On the HPA KEDA creates, each s0, s1 metric maps back to its trigger: the cron schedule, the Prometheus query and threshold, the Kafka topic and lag.',
    chips: [
      { value: 'Pause', label: 'at current or given replicas' },
      { value: 'Triggers', label: 'on the ScaledObject and its HPA' },
      { value: 'Auth', label: 'sources and users, no secrets' },
    ],
    shot: shotBySlug('keda-hpa'),
    link: { href: '/docs/integrations/', label: 'Platform integrations' },
  },
]

const stats = [
  { value: '62', label: 'resource kinds with YAML edit, delete and scale' },
  { value: '11', label: 'platform integrations with typed views' },
  { value: '13', label: 'themes, six light and seven dark' },
  { value: '0', label: 'components installed in the cluster' },
  { value: '22 MB', label: 'macOS download, signed and notarized' },
  { value: 'Apache', label: '2.0 license, no account, no tier' },
]

const capabilities = [
  {
    icon: Boxes,
    title: 'Every built-in kind',
    body: 'Workloads, networking, storage, config, admission, autoscaling and the full RBAC set, each with list, detail, YAML edit, delete and scale where it applies.',
  },
  {
    icon: ScanSearch,
    title: 'Access Review',
    body: 'Pick a user, group or ServiceAccount and read its effective permissions as a resource-by-verb matrix, with the binding and role behind every cell. Wildcards and cluster-admin are flagged.',
  },
  {
    icon: Puzzle,
    title: 'Custom resources',
    body: 'CRDs are discovered on connect and grouped by API group. A kind installed while you are connected appears without a restart.',
  },
  {
    icon: Blocks,
    title: 'Istio, Karpenter and KEDA',
    body: 'VirtualServices and DestinationRules, NodePools and NodeClaims, and KEDA triggers mapped back onto the HPAs they drive.',
  },
  {
    icon: FileDiff,
    title: 'YAML, scale and rollout',
    body: 'Monaco editor with a server-side dry-run diff, inline scale, restart, pause and resume, in-place pod resize, and rollout history with one-click rollback.',
  },
  {
    icon: Server,
    title: 'Nodes',
    body: 'Usage and pressure per node, cordon and uncordon, PDB-aware drain with live progress, and a root shell without SSH.',
  },
  {
    icon: SquareTerminal,
    title: 'Terminal drawer',
    body: 'A local shell per context with KUBECONFIG already set, so kubectl, helm and k9s hit the right cluster. Or launch your own terminal app with the context selected.',
  },
  {
    icon: Layers,
    title: 'Cluster overviews',
    body: 'Capacity donuts, workload health bars and a recent-events feed, for a single cluster or an aggregated set.',
  },
]

const compareRows = [
  'License and price',
  'Installed in the cluster',
  'Account or sign-in',
  'Several clusters at once',
  'RBAC',
  'Helm',
  'Argo CD and Flux',
  'Gateway API',
]
---

<BaseLayout title={SITE.title} bareTitle description={SITE.metaDescription} path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-10 md:pt-14">
    <div class="mx-auto max-w-5xl text-center">
      <p class="eyebrow rise">kubernetes desktop gui for macOS, Linux and Windows</p>
      <h1 class="display rise rise-2 mt-4 text-[2.25rem] sm:text-5xl lg:text-[3.25rem]">
        Your Kubernetes clusters, live.<br />
        <span class="marker">Nothing installed in them.</span>
      </h1>
      <p class="lede rise rise-3 mx-auto mt-5 max-w-2xl">
        Klustr is a free, open-source Kubernetes desktop client for macOS, Linux and Windows. It reads the kubeconfig you
        already have and drives the Kubernetes API the way kubectl does: live resources, RBAC review, Helm, Argo CD,
        Flux, Gateway API and cert-manager in one window.
      </p>

      <InstallTabs group="hero" version={version} detectOs class="rise rise-4 mx-auto mt-7 max-w-2xl" />

      <div class="rise rise-4 mt-5 flex flex-wrap items-center justify-center gap-3">
        <a href={LATEST_RELEASE_URL} class="btn btn-primary" target="_blank" rel="noreferrer">
          <Download size={15} />
          <span>Download <span data-version-inline>{version}</span></span>
        </a>
        <button class="btn btn-ghost" type="button" data-demo-open>
          <Play size={15} />
          <span>Watch the demo</span>
        </button>
        <a href="/install/" class="btn btn-ghost">All install options</a>
      </div>
    </div>

    <div class="mt-10">
      <HeroSlider />
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-rule py-5">
    <div class="strip mx-auto max-w-6xl px-5">
      <div class="strip-item"><ShieldCheck size={16} /><span><b>Pure client.</b> No agent, operator, CRD or sidecar in the cluster.</span></div>
      <div class="strip-item"><Zap size={16} /><span><b>Live, never polled.</b> client-go informers push every change as it lands.</span></div>
      <div class="strip-item"><KeyRound size={16} /><span><b>Just your kubeconfig.</b> Exec plugins and aws-vault work from the Dock.</span></div>
      <div class="strip-item"><Scale size={16} /><span><b>Open source, Apache-2.0.</b> No account, no activation, no paid tier.</span></div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="scroll-mt-20 py-14">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-2xl">
        <p class="eyebrow">twelve workflows</p>
        <h2 class="display mt-3 text-3xl sm:text-4xl">The jobs kubectl makes you stitch together.</h2>
        <p class="lede mt-4">
          One Kubernetes GUI for the day-to-day work and for the platform tooling around it. Each integration below
          appears when its CRDs are found in a cluster and comes with its own status views and actions.
        </p>
      </div>
      <div class="mt-8">
        <FeatureTabs features={features} />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-rule py-12">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
        <h2 class="display text-2xl">Counted from the source.</h2>
        <p class="font-mono text-sm text-ink-3">Counts from the repository and the latest release, not benchmark claims.</p>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {
          stats.map((stat) => (
            <div class="sheet stat ticks">
              <div class="stat-value">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="max-w-2xl">
      <p class="eyebrow">everything else</p>
      <h2 class="display mt-3 text-3xl sm:text-4xl">Built for the whole cluster, not a demo namespace.</h2>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        capabilities.map(({ icon: Icon, title, body }) => {
          const clip = clipById(CAPABILITY_CLIPS[title])
          return (
            <div class="sheet cap">
              <h3>
                <Icon size={18} /> {title}
              </h3>
              <p>{body}</p>
              {clip && (
                <button
                  class="cap-watch"
                  type="button"
                  data-demo-open
                  data-demo-src={clip.src}
                  data-demo-poster={clip.poster}
                  data-demo-title={clip.title}
                >
                  <Play size={13} />
                  <span>Watch</span>
                </button>
              )}
            </div>
          )
        })
      }
    </div>
  </section>

  <!-- Compare -->
  <section id="compare" class="scroll-mt-20 border-t border-rule py-14">
    <div class="mx-auto max-w-6xl px-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">compare</p>
          <h2 class="display mt-3 text-3xl sm:text-4xl">Klustr vs Lens, k9s and Headlamp.</h2>
          <p class="lede mt-4">
            Looking for a Lens alternative? Each of these is a good tool with a different shape. The table keeps to
            facts you can check in their documentation, and the page behind each name says where that tool is the
            better pick.
          </p>
        </div>
        <a href="/compare/" class="btn btn-ghost btn-sm shrink-0">All {ROWS.length} rows</a>
      </div>
      <CompareTable tools={['klustr', 'lens', 'k9s', 'headlamp']} rows={compareRows} grouped={false} class="mt-8" />
      <p class="mt-3 text-sm text-ink-3">
        Facts checked against each tool’s documentation on {REVIEWED_ON}. Full pages:{' '}
        <a href="/compare/lens/" class="text-accent">Klustr vs Lens</a>,{' '}
        <a href="/compare/k9s/" class="text-accent">Klustr vs k9s</a> and{' '}
        <a href="/compare/headlamp/" class="text-accent">Klustr vs Headlamp</a>.
      </p>
    </div>
  </section>

  <!-- Final call -->
  <section class="border-t border-rule py-16">
    <div class="mx-auto max-w-2xl px-5 text-center">
      <h2 class="display text-3xl sm:text-4xl">Point it at a context.</h2>
      <p class="lede mt-4">One binary on your machine. Nothing in the cluster. Every context in your kubeconfig.</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={LATEST_RELEASE_URL} class="btn btn-primary" target="_blank" rel="noreferrer">
          <Download size={15} />
          <span>Download <span data-version-inline>{version}</span></span>
        </a>
        <a href={REPO_URL} class="btn btn-ghost" target="_blank" rel="noreferrer">View on GitHub</a>
      </div>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-ink-3">
        <li class="inline-flex items-center gap-2"><BrandIcon brand="apple" /> macOS on Apple Silicon, notarized</li>
        <li class="inline-flex items-center gap-2"><BrandIcon brand="linux" /> Linux amd64 as tarball, .deb and AUR</li>
        <li class="inline-flex items-center gap-2"><BrandIcon brand="windows" /> Windows amd64 as zip, not code-signed yet</li>
      </ul>
    </div>
  </section>

  <!-- Demo video -->
  <dialog id="demo" class="m-auto w-[min(96vw,1100px)] rounded-(--radius-sheet) border border-rule-strong bg-paper p-0 backdrop:bg-paper/90 backdrop:backdrop-blur-sm">
    <div class="flex items-center justify-between gap-3 border-b border-rule px-4 py-2">
      <span class="font-mono text-sm text-ink-2" data-demo-title>{DEMO_TITLE}</span>
      <button class="icon-btn" type="button" data-demo-close aria-label="Close">
        <X size={16} />
      </button>
    </div>
    <video
      class="block w-full"
      controls
      preload="none"
      playsinline
      poster={poster.src}
      src="/hero.mp4"
      data-demo-video
      data-demo-default-poster={poster.src}
    >
    </video>
  </dialog>

  <script>
    const dialog = document.getElementById('demo') as HTMLDialogElement | null
    const video = dialog?.querySelector<HTMLVideoElement>('[data-demo-video]')
    const label = dialog?.querySelector<HTMLElement>('[data-demo-title]')
    const defaults = { src: '/hero.mp4', poster: video?.dataset.demoDefaultPoster ?? '', title: label?.textContent ?? '' }
    // The hero button plays the walk-through; a capability card's Watch button
    // passes its own clip.
    document.querySelectorAll<HTMLElement>('[data-demo-open]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !video) return
        const src = button.dataset.demoSrc ?? defaults.src
        if (video.getAttribute('src') !== src) {
          video.src = src
          video.poster = button.dataset.demoPoster ?? defaults.poster
        }
        video.loop = src !== defaults.src
        if (label) label.textContent = button.dataset.demoTitle ?? defaults.title
        dialog.showModal()
        void video.play().catch(() => {})
      })
    })
    dialog?.querySelector('[data-demo-close]')?.addEventListener('click', () => dialog.close())
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close()
    })
    dialog?.addEventListener('close', () => video?.pause())
  </script>
</BaseLayout>
