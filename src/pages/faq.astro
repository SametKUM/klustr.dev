---
import DocsLayout from '../layouts/DocsLayout.astro'
import { FAQ, FAQ_PAGE } from '../data/faq'
import { renderFragment, stripMarkdown } from '../lib/markdown'
import { breadcrumbLd, faqLd, graph } from '../lib/seo'

const items = FAQ.map((f) => ({
  ...f,
  html: renderFragment(f.answer),
  text: stripMarkdown(f.answer),
}))

const headings = items.map((f) => ({ depth: 2, id: f.id, text: f.question }))

const jsonLd = graph([
  faqLd(items.map((f) => ({ question: f.question, answerText: f.text }))),
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq/' }]),
])
---

<DocsLayout
  title={FAQ_PAGE.title}
  eyebrow="faq"
  lede={FAQ_PAGE.lede}
  description={FAQ_PAGE.description}
  path="/faq/"
  headings={headings}
  jsonLd={jsonLd}
>
  <div class="prose">
    {
      items.map((f) => (
        <section class="mt-10 first:mt-0">
          <h2 id={f.id}>{f.question}</h2>
          <Fragment set:html={f.html} />
        </section>
      ))
    }
  </div>
</DocsLayout>
