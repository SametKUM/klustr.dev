---
import BrandIcon from '../components/BrandIcon.astro'
import CommandBlock from '../components/CommandBlock.astro'
import DocsLayout from '../layouts/DocsLayout.astro'
import { INSTALL_PAGE, INSTALL_PLATFORMS, INSTALL_REQUIREMENTS, INSTALL_UPDATE, INSTALL_VERIFY } from '../data/install'
import { latestRelease } from '../lib/github'
import { renderFragment, renderInline } from '../lib/markdown'
import { articleLd, breadcrumbLd, graph } from '../lib/seo'

const release = await latestRelease()

const headings = [...INSTALL_PLATFORMS, INSTALL_UPDATE, INSTALL_VERIFY, INSTALL_REQUIREMENTS].map((s) => ({
  depth: 2,
  id: s.id,
  text: s.title,
}))

const jsonLd = graph([
  articleLd({ headline: 'Install Klustr', description: INSTALL_PAGE.description, path: '/install/' }),
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Install', path: '/install/' }]),
])
---

<DocsLayout
  title={INSTALL_PAGE.title}
  bareTitle
  eyebrow="install"
  lede={INSTALL_PAGE.lede(release?.tag)}
  description={INSTALL_PAGE.description}
  path="/install/"
  headings={headings}
  jsonLd={jsonLd}
>
  <div class="flex flex-col gap-12">
    {
      INSTALL_PLATFORMS.map((platform) => (
        <section id={platform.id} class="scroll-mt-24">
          <div class="mb-4 flex items-center gap-3">
            <span class="icon-btn pointer-events-none">
              <BrandIcon brand={platform.brand} size={platform.iconSize} />
            </span>
            <div>
              <h2 class="display text-2xl">{platform.title}</h2>
              <p class="text-sm text-ink-3">{platform.summary}</p>
            </div>
          </div>
          {platform.steps.map((step, i) =>
            'label' in step ? (
              <p class:list={['eyebrow mb-2', { 'mt-5': i > 0 }]}>{step.label.toLowerCase()}</p>
            ) : 'lead' in step ? (
              <p class="mb-2 text-sm text-ink-2" set:html={renderInline(step.lead)} />
            ) : 'command' in step ? (
              <CommandBlock html={step.command} />
            ) : (
              <p class="mt-3 text-sm text-ink-2" set:html={renderInline(step.note)} />
            ),
          )}
        </section>
      ))
    }

    <section id={INSTALL_UPDATE.id} class="scroll-mt-24">
      <h2 class="display text-2xl">{INSTALL_UPDATE.title}</h2>
      <p class="mt-2 text-sm text-ink-2" set:html={renderInline(INSTALL_UPDATE.intro)} />
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          INSTALL_UPDATE.channels.map((channel) => (
            <div>
              <p class="eyebrow mb-2">{channel.label.toLowerCase()}</p>
              <CommandBlock html={channel.command} />
            </div>
          ))
        }
      </div>
      <p class="mt-3 text-sm text-ink-2" set:html={renderInline(INSTALL_UPDATE.note)} />
    </section>

    <section id={INSTALL_VERIFY.id} class="scroll-mt-24">
      <h2 class="display text-2xl">{INSTALL_VERIFY.title}</h2>
      <p class="mt-2 text-sm text-ink-2" set:html={renderInline(INSTALL_VERIFY.intro)} />
      <div class="mt-4">
        <CommandBlock html={INSTALL_VERIFY.command} />
      </div>
    </section>

    <section id={INSTALL_REQUIREMENTS.id} class="scroll-mt-24">
      <h2 class="display text-2xl">{INSTALL_REQUIREMENTS.title}</h2>
      <ul class="prose mt-3 list-disc pl-5 text-sm">
        {INSTALL_REQUIREMENTS.items.map((item) => <li set:html={renderFragment(item).replace(/^<p>|<\/p>\s*$/g, '')} />)}
      </ul>
      <p class="mt-4 text-sm text-ink-3" set:html={renderInline(INSTALL_REQUIREMENTS.note)} />
    </section>
  </div>
</DocsLayout>
