---
import DocsLayout from '../layouts/DocsLayout.astro'
import { CHANGELOG_PAGE, changelogEntries } from '../lib/changelog'
import { renderFragment, renderInline } from '../lib/markdown'
import { breadcrumbLd, graph } from '../lib/seo'

const entries = (await changelogEntries()).map((e) => ({ ...e, html: renderFragment(e.notes) }))

const headings = entries.map((e) => ({ depth: 2, id: e.id, text: e.tag }))
const latest = entries[0]
const description = latest
  ? `Release notes for Klustr. Latest: ${latest.tag}, published ${latest.date}. Every change to the Kubernetes desktop client, version by version.`
  : 'Release notes for Klustr, the Kubernetes desktop client, version by version.'
---

<DocsLayout
  title={CHANGELOG_PAGE.title}
  eyebrow="releases"
  lede={CHANGELOG_PAGE.lede}
  description={description}
  path="/changelog/"
  headings={headings}
  jsonLd={graph([breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Changelog', path: '/changelog/' }])])}
>
  {
    entries.length === 0 ? (
      <div class="prose" set:html={renderFragment(CHANGELOG_PAGE.unavailable)} />
    ) : (
      <div class="flex flex-col gap-12">
        {entries.map((e) => (
          <section class="prose" id={e.id}>
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="mt-0!">
                {e.tag}
                {e.prerelease && <span class="ml-2 align-middle font-sans text-xs font-normal text-warn">pre-release</span>}
              </h2>
              <a href={e.url} class="font-mono text-xs no-underline" target="_blank" rel="noreferrer">
                {e.date}. {CHANGELOG_PAGE.assets}
              </a>
            </div>
            <Fragment set:html={e.html} />
          </section>
        ))}
        <p class="text-sm text-ink-3" set:html={renderInline(CHANGELOG_PAGE.older)} />
      </div>
    )
  }
</DocsLayout>
